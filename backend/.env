LOG_LEVEL=DEBUG

# ============================================================================
# LOG ROTATION CONFIGURATION (Production-Ready Hybrid Approach)
# ============================================================================

# Log directory for session-based logging with size-based rotation
# Structure: logs/session_YYYY-MM-DD_HH-MM-SS/relo_backend.log
# - New session directory created on each app restart
# - Size-based rotation within session (rotates when file gets too large)
# - Logs are NEVER deleted (infinite retention)
# Default: backend/logs
LOG_DIRECTORY=logs

# Maximum log file size in MB before rotation
# Logs rotate automatically WHILE app is running when size exceeds this limit
# Options: 10, 25, 50, 100, 200, etc.
# Default: 50 (rotate when file reaches 50MB)
# Example: 25 = rotate at 25MB, 100 = rotate at 100MB
# When rotated, backup file gets timestamped: relo_backend_2025-10-17_14-30-00.log
# All rotated files keep the .log extension for easy upload to S3
LOG_MAX_SIZE_MB=1

# Number of backup log files to keep PER SESSION
# Set to 0 to NEVER delete logs (recommended for production)
# Set to N to keep only last N rotated logs per session
# Default: 0 (infinite retention - NEVER delete)
# Example: 0 = keep all logs forever, 5 = keep last 5 rotated files per session
LOG_ROTATION_BACKUP_COUNT=0

# ============================================================================
# MODEL PROVIDER CONFIGURATION
# ============================================================================

# Model Provider Selection
# Options: ollama, huggingface
# Default: ollama
# - ollama: Use Ollama server (localhost:11434) with local models
# - huggingface: Use HuggingFace model server (localhost:11435) with auto-download
MODEL_PROVIDER=huggingface

# ============================================================================
# OLLAMA MODEL CONFIGURATION
# ============================================================================

# Vision Language Model Selection (for Ollama provider)
# Options: qwen2.5vl:3b, minicpm-v:latest, llava:7b-v1.6-mistral-q4_K_M
# Default: qwen2.5vl:3b
# Recommended: minicpm-v:latest (better OCR and damage detection)
OLLAMA_MODEL=qwen2.5vl:3b

# Ollama Server Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# ============================================================================
# HUGGINGFACE MODEL CONFIGURATION
# ============================================================================

# HuggingFace Model Selection (for huggingface provider)
# Options:
#   - Qwen/Qwen3-VL-4B-Instruct (4B params, RECOMMENDED - no thinking mode, fits in 8GB with 4-bit)
#   - Qwen/Qwen2-VL-2B-Instruct (2B params, lighter for low memory)
#   - Qwen/Qwen2-VL-7B-Instruct (7B params, better accuracy, needs more VRAM)
#   - Qwen/Qwen3-VL-4B-Thinking (4B params, includes chain-of-thought reasoning)
#   - NexaAI/Qwen3-VL-4B-Thinking-GGUF (4B params, GGUF format - architecture not supported)
#   - Other vision-language models from HuggingFace Hub
# Default: Qwen/Qwen3-VL-4B-Instruct
# Models are automatically downloaded from HuggingFace Hub on first use
HUGGINGFACE_MODEL=Qwen/Qwen3-VL-4B-Instruct
# Quantization Settings (for transformers models)
# Options: none, 4bit, 8bit
# - none: Full precision (BF16) - requires ~10GB VRAM
# - 4bit: 4-bit NF4 quantization - requires ~3-4GB VRAM (RECOMMENDED for 8GB GPU)
# - 8bit: 8-bit quantization - requires ~5-6GB VRAM (better quality than 4bit)
# Note: 6-bit quantization is NOT supported (bitsandbytes only supports 4-bit and 8-bit)
# Default: 4bit
TRANSFORMERS_QUANTIZATION=4bit

# GGUF Quantization Level (only for GGUF models like NexaAI/Qwen3-VL-4B-Thinking-GGUF)
# Not used when using transformers models
# GGUF_QUANTIZATION=Q4_0

# HuggingFace Server Configuration
HF_SERVER_HOST=localhost
HF_SERVER_PORT=11435

# Response Generation Configuration
# Maximum number of new tokens to generate in response
# Higher values allow longer responses but take more time
# Default: 512 (can be overridden per-request via options)
MAX_RESPONSE_TOKENS=512

# NOTE: Model Behavior
# - Qwen3-VL-4B-Instruct: Direct responses, no thinking mode (RECOMMENDED)
# - Qwen3-VL-4B-Thinking: Includes chain-of-thought reasoning (verbose)
#
# If using the Thinking model and need to minimize verbosity:
#   - Use lower temperature values (0.1-0.3) for more direct responses
#   - Use concise, direct prompts
#   - Request JSON format which tends to suppress verbose reasoning
#   - Increase MAX_RESPONSE_TOKENS if thinking causes truncation of final answer


# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================

# Camera Type Selection
# Options: CV60, OAKD
# - CV60: Zebra CV60 camera using eBUS SDK (default)
# - OAKD: OAK-D Pro camera using DepthAI SDK
# Default: CV60
CAMERA_TYPE=OAKD

# Tap-to-Focus Feature
# Enable/disable tap-to-focus on camera preview
# Options: true, false
# Default: true
TAP_TO_FOCUS_ENABLED=false

# ============================================================================
# VLM IMAGE PREPROCESSING CONFIGURATION
# ============================================================================

# MASTER TOGGLE - Turn preprocessing on/off for ALL agents
# Options: true, false
# Recommended: true (improves accuracy)
PREPROCESSING_ENABLED=true

# ----------------------------------------------------------------------------
# PER-AGENT TOGGLES (Override master toggle for specific agents)
# ----------------------------------------------------------------------------

# Initial Classifier - Basic garment attributes (type, color, pattern)
# Usually doesn't need preprocessing as modern VLMs handle well
PREPROCESSING_INITIAL_ENABLED=true

# Detail Extractor - OCR for brand/size labels
# Preprocessing highly recommended for text readability
PREPROCESSING_DETAIL_ENABLED=false

# Damage Detector - Identify garment damage
# Preprocessing helps detect subtle damage
PREPROCESSING_DAMAGE_ENABLED=true

# ----------------------------------------------------------------------------
# PREPROCESSING TYPES AND LEVELS
# ----------------------------------------------------------------------------

# INITIAL CLASSIFIER OPTIONS
# Type options: none, contrast, sharpen, denoise, auto_enhance
# Recommended: sharpen (mild sharpening for clarity)
PREPROCESSING_INITIAL_TYPE=sharpen
# Level options: low, medium, high (affects intensity)
PREPROCESSING_INITIAL_LEVEL=low

# Contrast Parameters (for initial_classifier when type=contrast)
PREPROCESSING_INITIAL_CONTRAST_ALPHA=1.2   # Range: 1.0-3.0, Recommended: 1.2
PREPROCESSING_INITIAL_CONTRAST_BETA=5      # Range: -100-100, Recommended: 5

# Sharpening Parameters (for initial_classifier when type=sharpen)
PREPROCESSING_INITIAL_SHARPEN_AMOUNT=1.1   # Range: 1.0-3.0, Recommended: 1.1 (gentler than damage)
PREPROCESSING_INITIAL_SHARPEN_SIGMA=0.8    # Range: 0.5-2.0, Recommended: 0.8

# Denoise Parameters (for initial_classifier when type=denoise)
PREPROCESSING_INITIAL_DENOISE_H=10         # Range: 5-30, Recommended: 10
PREPROCESSING_INITIAL_DENOISE_TEMPLATE=7   # Range: 5-21 (odd), Recommended: 7
PREPROCESSING_INITIAL_DENOISE_SEARCH=21    # Range: 11-31 (odd), Recommended: 21

# DETAIL EXTRACTOR OPTIONS
# Type options: contrast, sharpen, clahe, clahe_sharpen, threshold
# Recommended: clahe_sharpen (CLAHE + sharpening for optimal OCR)
# - contrast: Basic contrast enhancement
# - sharpen: Edge sharpening for text
# - clahe: Adaptive histogram equalization
# - clahe_sharpen: Both CLAHE and sharpening (best for OCR)
# - threshold: Binary thresholding for clear text
PREPROCESSING_DETAIL_TYPE=clahe_sharpen
# Level options: low, medium, high
# Recommended: low (subtle enhancement)
PREPROCESSING_DETAIL_LEVEL=low

# CLAHE Parameters (for detail_extractor when type=clahe or clahe_sharpen)
PREPROCESSING_DETAIL_CLAHE_CLIP_LIMIT=3.0  # Range: 1.0-10.0, Recommended: 1.0 (minimal for OCR)
PREPROCESSING_DETAIL_CLAHE_GRID_SIZE=12     # Range: 4-16, Recommended: 8

# Sharpening Parameters (for detail_extractor when type=clahe_sharpen or sharpen)
PREPROCESSING_DETAIL_SHARPEN_AMOUNT=1.15   # Range: 1.0-3.0, Recommended: 1.15 (gentler than damage's 1.25)
PREPROCESSING_DETAIL_SHARPEN_RADIUS=1.0    # Range: 0.5-2.0, Recommended: 1.0
PREPROCESSING_DETAIL_SHARPEN_THRESHOLD=0   # Range: 0-20, Recommended: 0

# Contrast Parameters (for detail_extractor when type=contrast)
PREPROCESSING_DETAIL_CONTRAST_ALPHA=1.0    # Range: 1.0-3.0, Recommended: 1.5
PREPROCESSING_DETAIL_CONTRAST_BETA=0       # Range: -100-100, Recommended: 0

# DAMAGE DETECTOR OPTIONS
# Type options: sharpen, edge_enhance, contrast, sharpen_contrast, sobel
# Recommended: sharpen (current implementation)
# - sharpen: Unsharp mask for damage visibility
# - edge_enhance: Emphasize edges and boundaries
# - contrast: Improve contrast for damage
# - sharpen_contrast: Both sharpening and contrast
# - sobel: Edge detection filter
PREPROCESSING_DAMAGE_TYPE=contrast
# Level options: low, medium, high
# Recommended: low (subtle enhancement to avoid artifacts)
PREPROCESSING_DAMAGE_LEVEL=medium

# Sharpening Parameters (for damage_detector when type=sharpen)
PREPROCESSING_DAMAGE_SHARPEN_AMOUNT=1.25    # Range: 1.0-3.0, Recommended: 1.5
PREPROCESSING_DAMAGE_SHARPEN_SIGMA=1.0     # Range: 0.5-2.0, Recommended: 1.0
PREPROCESSING_DAMAGE_BLUR_SIZE=5           # Range: 3-9 (odd only), Recommended: 5

# Edge Enhancement Parameters (for damage_detector when type=edge_enhance)
PREPROCESSING_DAMAGE_EDGE_KERNEL_SIZE=3    # Range: 3-7 (odd only), Recommended: 3
PREPROCESSING_DAMAGE_EDGE_STRENGTH=1.5     # Range: 1.0-3.0, Recommended: 1.5

# Contrast Parameters (for damage_detector when type=contrast)
PREPROCESSING_DAMAGE_CONTRAST_ALPHA=1.4    # Range: 1.0-3.0, Recommended: 1.3
PREPROCESSING_DAMAGE_CONTRAST_BETA=15      # Range: -100-100, Recommended: 10

# ----------------------------------------------------------------------------
# ADVANCED OPTIONS
# ----------------------------------------------------------------------------

# Save preprocessed images for debugging
# Options: true, false
PREPROCESSING_SAVE_DEBUG_IMAGES=true

# Cache preprocessed images
# Options: true, false
PREPROCESSING_CACHE_ENABLED=true

# Preprocessing timeout in seconds
PREPROCESSING_TIMEOUT_SECONDS=5

# ============================================================================
# IMAGE SAVING CONFIGURATION
# ============================================================================

# Enable frame saving to captured_frames directory
# Options: true, false
# Images are saved to: backend/captured_frames/{agent_name}/
# Default: true
SAVE_DEBUG_FRAMES=true

# JPEG quality for saved frames (1-100)
# 90 = Very good quality for ML training, manageable file size
# 95 = Excellent quality, larger files
# Higher quality = better for model training but larger files
JPEG_QUALITY=90

# ============================================================================
# TABLE PERFORMANCE CONFIGURATION
# ============================================================================

# Table row limit warning threshold
# When frontend table exceeds this many rows, warn user to export and clear
# Prevents performance degradation from large DOM and memory usage
# Default: 200 rows
TABLE_ROW_LIMIT_WARNING=4
