# Detection Mode Configuration
# Options: "custom", "library", "hybrid"
DETECTION_MODE=hybrid

# Input Source Configuration
# Options: "image", "camera"
INPUT_SOURCE=camera

# Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Image Configuration
IMAGE_PATH=examples/sample_barcodes/

# Custom Detector Configuration
CUSTOM_DETECTOR_ALGORITHM=code128
CUSTOM_DETECTOR_PREPROCESSING=true
CUSTOM_DETECTOR_EDGE_THRESHOLD=50
CUSTOM_DETECTOR_MIN_BAR_WIDTH=2
CUSTOM_DETECTOR_MAX_BAR_WIDTH=20

# Library Fallback Configuration
LIBRARY_FALLBACK_ENABLED=true
LIBRARY_PRIMARY=pyzbar
LIBRARY_SECONDARY=zxing

# Performance Configuration
ENABLE_GPU_ACCELERATION=false
ENABLE_MULTITHREADING=true
MAX_THREADS=4

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/barcode_detector.log
ENABLE_PERFORMANCE_LOGGING=true

# Detection Parameters
MIN_CONFIDENCE=0.7
MAX_DETECTION_TIME=1000
ENABLE_MULTIPLE_DETECTION=true

# Output Configuration
SHOW_BOUNDING_BOXES=true
SHOW_DETECTION_TIME=true
SAVE_ANNOTATED_IMAGES=false
OUTPUT_DIRECTORY=output/